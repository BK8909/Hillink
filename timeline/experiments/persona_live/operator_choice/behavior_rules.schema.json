{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence-preserving behavior rule catalogue v1",
  "type": "object", "required": ["version", "source_commit", "input_sha256", "source_access", "independent_evaluation_eligible", "rules", "agents"],
  "properties": {
    "version": {"const": "operator_rules_v1"},
    "source_commit": {"type": "string"}, "input_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_access": {"const": "approved_cards_only"}, "independent_evaluation_eligible": {"const": false},
    "agents": {"type": "array", "minItems": 1},
    "rules": {"type": "array", "items": {"$ref": "#/$defs/rule"}}
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["rule_id", "agent_id", "observed_behavior", "evaluated_aspect", "evidence_ids", "provenance", "rule_hypothesis", "applicable_context", "counter_evidence", "confidence_basis", "evidence_level", "verification_status", "scenario_relevance"],
      "properties": {
        "rule_id": {"type": "string"}, "agent_id": {"type": "string"}, "observed_behavior": {"type": "string"},
        "evaluated_aspect": {"type": "object", "required": ["target", "aspect", "polarity"]},
        "evidence_ids": {"type": "array", "items": {"type": "string"}},
        "provenance": {"type": "object", "required": ["layer", "source_access", "card_path", "original_anchor_verified"],
          "properties": {"layer": {"enum": ["observed", "human_inference", "evaluator_comment", "ai_estimate", "unknown", "scenario_assumption"]},
                         "original_anchor_verified": {"type": "boolean"}}},
        "rule_hypothesis": {"type": "string", "minLength": 1},
        "applicable_context": {"type": "object", "required": ["scope", "transfer_limit"]},
        "counter_evidence": {"type": "array", "items": {"type": "string"}},
        "confidence_basis": {"type": "string", "minLength": 1},
        "evidence_level": {"enum": ["direct_observation", "source_confirmed_inference", "provisional_hypothesis", "insufficient"]},
        "verification_status": {"enum": ["card_candidate", "source_verified", "insufficient"]},
        "scenario_relevance": {"type": "array", "items": {"enum": ["wine_fair", "riverpark", "beer_festival"]}}
      },
      "allOf": [{"if": {"properties": {"verification_status": {"const": "source_verified"}}},
                 "then": {"properties": {"provenance": {"properties": {"original_anchor_verified": {"const": true}}}}}}]
    }
  }
}
