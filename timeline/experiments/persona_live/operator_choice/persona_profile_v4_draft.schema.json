{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Author profile V4 input contract DRAFT; no actual V4 profile supplied",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "author_group_id", "sharing_level", "posts", "visits", "experiences", "purchases", "evidence", "claims"],
  "properties": {
    "contract_version": {"const": "persona_v4_input_draft_0.1"},
    "author_group_id": {"type": "string", "pattern": "^AG-[A-Za-z0-9_-]+$"},
    "sharing_level": {"enum": ["deidentified_research", "restricted_local"]},
    "source_inventory_reports": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["reported_post_count", "verification_status", "basis_ref"],
      "properties": {"reported_post_count": {"type": "integer", "minimum": 0}, "verification_status": {"enum": ["reported_unverified", "metadata_verified"]}, "basis_ref": {"type": "string", "minLength": 1}}}},
    "posts": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["post_id", "access_status", "author_link_status", "author_link_ref"],
      "properties": {"post_id": {"type": "string", "pattern": "^POST-[A-Za-z0-9_-]+$"},
        "access_status": {"enum": ["unavailable", "metadata_only", "text_available", "text_and_media_available"]},
        "author_link_status": {"enum": ["verified", "user_attested", "unconfirmed"]}, "author_link_ref": {"type": ["string", "null"]}}}},
    "visits": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["visit_id", "post_ids", "link_status", "visit_date", "date_precision", "date_evidence_refs"],
      "properties": {"visit_id": {"type": "string", "minLength": 1}, "post_ids": {"$ref": "#/$defs/refs"},
        "link_status": {"enum": ["verified", "probable", "unassigned"]}, "visit_date": {"type": ["string", "null"]},
        "date_precision": {"enum": ["day", "month", "range", "unknown"]}, "date_evidence_refs": {"$ref": "#/$defs/refs"}}}},
    "experiences": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["experience_id", "post_ids", "visit_id", "activity", "participation_status", "first_visit_status", "evidence_refs"],
      "properties": {"experience_id": {"type": "string", "minLength": 1}, "post_ids": {"$ref": "#/$defs/refs"},
        "visit_id": {"type": ["string", "null"]}, "activity": {"type": "string", "minLength": 1},
        "participation_status": {"enum": ["observed_participation", "planned", "recommendation", "other_person", "unknown"]},
        "first_visit_status": {"enum": ["explicit_first", "explicit_repeat", "unknown"]}, "evidence_refs": {"$ref": "#/$defs/refs"}}}},
    "purchases": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["purchase_id", "experience_ids", "status", "amount", "amount_kind", "currency", "payer", "evidence_refs"],
      "properties": {"purchase_id": {"type": "string", "minLength": 1}, "experience_ids": {"$ref": "#/$defs/refs"},
        "status": {"enum": ["documented_order", "payment_verified", "planned", "unknown"]},
        "amount": {"type": ["number", "null"], "minimum": 0}, "amount_kind": {"enum": ["order_total", "list_price", "final_paid", "unknown"]},
        "currency": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"},
        "payer": {"type": ["string", "null"]}, "evidence_refs": {"$ref": "#/$defs/refs"}}}},
    "evidence": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["evidence_id", "post_id", "modality", "page", "source_root", "support_role", "anchor_status"],
      "properties": {"evidence_id": {"type": "string", "minLength": 1}, "post_id": {"type": "string", "minLength": 1},
        "modality": {"enum": ["text", "photo", "caption", "receipt", "metadata"]}, "page": {"type": ["integer", "null"], "minimum": 1},
        "source_root": {"type": "string", "minLength": 1},
        "support_role": {"enum": ["participation", "first_visit_statement", "visit_date", "prepurchase_decision", "purchase_record", "payment_record", "post_appraisal", "preference", "revisit", "metadata"]},
        "anchor_status": {"enum": ["verified_anchor", "supplied_page_note", "anchor_pending"]}}}},
    "claims": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["claim_id", "dimension", "deidentified_summary", "epistemic_status", "scope", "evidence_refs", "derived_from", "confidence_basis", "alternative_readings", "review"],
      "properties": {"claim_id": {"type": "string", "minLength": 1},
        "dimension": {"enum": ["participation_history", "new_experience_trial", "prepurchase_criteria", "post_appraisal", "specific_preference", "revisit_expression"]},
        "deidentified_summary": {"type": "string", "minLength": 1, "pattern": "^(?![\\s\\S]*https?://)[\\s\\S]*$"},
        "epistemic_status": {"enum": ["observed_fact", "direct_expression", "cross_experience_inference", "contextual_inference", "unknown"]},
        "scope": {"enum": ["experience", "visit", "author_provisional", "same_product_revisit"]},
        "evidence_refs": {"$ref": "#/$defs/refs"}, "derived_from": {"$ref": "#/$defs/refs"},
        "confidence_basis": {"type": "string", "minLength": 1}, "alternative_readings": {"type": "array", "items": {"type": "string"}},
        "review": {"type": "object", "additionalProperties": false, "required": ["status", "reviewer_ref"],
          "properties": {"status": {"enum": ["pending", "human_checked"]}, "reviewer_ref": {"type": ["string", "null"]}}}}}}
  },
  "$defs": {"refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}
}
